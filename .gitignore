# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e/test-results/
/e2e/playwright-report/
/e2e/.auth-state.json

# next.js
.next/
/out/

/research/

# production
/build
/--dry-run

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local

# vercel
.vercel

# cloudflare / opennext
.open-next
.wrangler/
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# turbo
.turbo

# lockfiles (only keep pnpm)
package-lock.json
yarn.lock
